{
  "openapi": "3.1.1",
  "info": {
    "title": "BI Platform API — RC2",
    "version": "0.1.0",
    "description": "Diseño, no software desplegado"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/health/live": {
      "get": {
        "operationId": "getLiveness",
        "responses": {
          "200": {
            "description": "Live",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "getReadiness",
        "responses": {
          "200": {
            "description": "Ready",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "Not ready",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/semantic/queries": {
      "post": {
        "operationId": "runSemanticQuery",
        "description": "Only after auth+policy are implemented and tested; no free SQL or client ActorContext.",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SemanticQueryRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Bounded, typed result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TypedResultSet"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "Stale model or snapshot",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Semantic validation error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Quota exceeded",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "500": {
            "description": "Internal error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Problem": {
        "type": "object",
        "required": [
          "type",
          "title",
          "status",
          "code",
          "request_id"
        ],
        "properties": {
          "type": {
            "type": "string",
            "format": "uri-reference"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "detail": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]+$"
          },
          "request_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      },
      "ModelRef": {
        "type": "object",
        "required": [
          "id",
          "revision"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "TypedValue": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "type",
              "value"
            ],
            "properties": {
              "type": {
                "const": "string"
              },
              "value": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "type",
              "value"
            ],
            "properties": {
              "type": {
                "const": "decimal"
              },
              "value": {
                "type": "string",
                "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "type",
              "value"
            ],
            "properties": {
              "type": {
                "const": "int64"
              },
              "value": {
                "type": "string",
                "pattern": "^-?(0|[1-9][0-9]*)$"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "type",
              "value"
            ],
            "properties": {
              "type": {
                "const": "float64"
              },
              "value": {
                "type": "number"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "type",
              "value"
            ],
            "properties": {
              "type": {
                "const": "boolean"
              },
              "value": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "type",
              "value"
            ],
            "properties": {
              "type": {
                "const": "date"
              },
              "value": {
                "type": "string",
                "format": "date"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "type",
              "value"
            ],
            "properties": {
              "type": {
                "const": "timestamptz"
              },
              "value": {
                "type": "string",
                "format": "date-time"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "null"
              }
            },
            "additionalProperties": false
          }
        ]
      },
      "Filter": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "op",
              "items"
            ],
            "properties": {
              "op": {
                "enum": [
                  "and",
                  "or"
                ]
              },
              "items": {
                "type": "array",
                "minItems": 1,
                "maxItems": 20,
                "items": {
                  "$ref": "#/components/schemas/Filter"
                }
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "op",
              "field_id",
              "value"
            ],
            "properties": {
              "op": {
                "enum": [
                  "eq",
                  "gte",
                  "lte"
                ]
              },
              "field_id": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "$ref": "#/components/schemas/TypedValue"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "op",
              "field_id"
            ],
            "properties": {
              "op": {
                "enum": [
                  "is_null",
                  "is_not_null"
                ]
              },
              "field_id": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        ]
      },
      "SemanticQueryRequest": {
        "type": "object",
        "required": [
          "model",
          "measures"
        ],
        "properties": {
          "model": {
            "$ref": "#/components/schemas/ModelRef"
          },
          "measures": {
            "type": "array",
            "minItems": 1,
            "maxItems": 40,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "dimensions": {
            "type": "array",
            "maxItems": 40,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "filter": {
            "$ref": "#/components/schemas/Filter"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50000
          }
        },
        "additionalProperties": false
      },
      "Column": {
        "type": "object",
        "required": [
          "id",
          "type",
          "nullable"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "string",
              "decimal",
              "int64",
              "float64",
              "boolean",
              "date",
              "timestamptz"
            ]
          },
          "nullable": {
            "type": "boolean"
          },
          "precision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 38
          },
          "scale": {
            "type": "integer",
            "minimum": 0,
            "maximum": 38
          },
          "unit": {
            "type": "string"
          },
          "timezone": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "SnapshotRef": {
        "type": "object",
        "required": [
          "dataset_id",
          "snapshot_id"
        ],
        "properties": {
          "dataset_id": {
            "type": "string",
            "minLength": 1
          },
          "snapshot_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "TypedResultSet": {
        "type": "object",
        "required": [
          "query_id",
          "model_revision",
          "dataset_snapshots",
          "columns",
          "rows",
          "row_count",
          "truncated"
        ],
        "properties": {
          "query_id": {
            "type": "string",
            "minLength": 1
          },
          "model_revision": {
            "type": "string",
            "minLength": 1
          },
          "dataset_snapshots": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/SnapshotRef"
            }
          },
          "columns": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Column"
            }
          },
          "rows": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/TypedValue"
              }
            }
          },
          "row_count": {
            "type": "integer",
            "minimum": 0
          },
          "truncated": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "Health": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "enum": [
              "ok",
              "degraded",
              "unavailable"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "bi_session",
        "description": "Cookie de sesión emitida y validada por el servidor; nunca autorizar a partir de claims aportados por el cliente. Ejemplo de contrato, nombre final configurable."
      }
    }
  }
}
