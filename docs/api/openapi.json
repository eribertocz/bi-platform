{
  "openapi": "3.1.0",
  "info": {
    "title": "bi-platform API",
    "description": "Contrato HTTP vigente. Única fuente de tipos para servidor y cliente.",
    "version": "0.1.0"
  },
  "paths": {
    "/health/live": {
      "get": {
        "tags": ["health"],
        "summary": "Liveness: el proceso responde. No consulta dependencias.",
        "operationId": "getLiveness",
        "responses": {
          "200": {
            "description": "Proceso activo",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Health" }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": ["health"],
        "summary": "Readiness: PostgreSQL accesible y migraciones aplicadas.",
        "operationId": "getReadiness",
        "responses": {
          "200": {
            "description": "Listo para servir",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Health" }
              }
            }
          },
          "503": {
            "description": "No listo; `checks` indica qué dependencia falla",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Health" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Health": {
        "type": "object",
        "required": ["status", "checks"],
        "properties": {
          "status": { "$ref": "#/components/schemas/HealthStatus" },
          "checks": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/HealthCheck" }
          }
        },
        "additionalProperties": false
      },
      "HealthCheck": {
        "type": "object",
        "required": ["name", "status"],
        "properties": {
          "name": { "type": "string", "examples": ["postgres", "migrations"] },
          "status": { "$ref": "#/components/schemas/HealthStatus" }
        },
        "additionalProperties": false
      },
      "HealthStatus": {
        "type": "string",
        "enum": ["ok", "degraded", "unavailable"]
      }
    }
  }
}
