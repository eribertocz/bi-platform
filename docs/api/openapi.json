{
  "openapi": "3.1.0",
  "info": {
    "title": "bi-platform API",
    "description": "Contrato HTTP vigente. Única fuente de tipos para servidor y cliente.",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/dev/login": {
      "post": {
        "tags": [
          "development"
        ],
        "description": "Solo feature dev-auth. Requiere Origin configurado; selecciona identidad sintética sin contraseña. Rota la sesión anterior.",
        "operationId": "devLogin",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DevLogin"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Sesión creada; cookie HttpOnly SameSite=Strict y Secure con HTTPS",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "400": {
            "description": "Solicitud JSON inválida",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Usuario no configurado",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Origin ausente o distinto al configurado",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Login de desarrollo deshabilitado",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "No se pudo crear la sesión",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/dev/users": {
      "get": {
        "tags": [
          "development"
        ],
        "description": "Solo feature dev-auth con BI_DEV_USERS configurado; únicamente fixtures sintéticos.",
        "operationId": "getDevUsers",
        "responses": {
          "200": {
            "description": "Identidades sintéticas configuradas",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/User"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Login de desarrollo deshabilitado",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/logout": {
      "post": {
        "tags": [
          "session"
        ],
        "operationId": "logout",
        "responses": {
          "204": {
            "description": "Sesión revocada y cookie eliminada"
          },
          "401": {
            "description": "Sin sesión válida",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Origin ausente o distinto al configurado",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "PostgreSQL no disponible",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "sessionCookie": []
          }
        ]
      }
    },
    "/api/v1/models": {
      "get": {
        "tags": [
          "models"
        ],
        "summary": "Recarga metrics/*.yaml, *.yml y *.json del proyecto y compila cada archivo con el catálogo analítico real.",
        "operationId": "listModels",
        "responses": {
          "200": {
            "description": "Estado del proyecto y resultados por archivo; sin configuración, lista vacía. Directorio inaccesible o límites globales: project_status unavailable y diagnóstico; nunca resultados parciales.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelsResponse"
                }
              }
            }
          },
          "401": {
            "description": "Sin sesión válida",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Demasiadas cargas simultáneas",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Motor no disponible o lectura fallida",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "504": {
            "description": "Tiempo de compilación agotado",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "sessionCookie": []
          }
        ]
      }
    },
    "/api/v1/oidc/callback": {
      "get": {
        "tags": [
          "session"
        ],
        "description": "Acción session:login, recurso sesión propia. Requiere state, code y cookie temporal; consume el intento atómicamente antes del intercambio. Solo redirige a /.",
        "operationId": "completeOidcLogin",
        "parameters": [
          {
            "name": "state",
            "in": "query",
            "description": "State de un solo uso",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "code",
            "in": "query",
            "description": "Código del proveedor",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "303": {
            "description": "Sesión de servidor creada; cookie HttpOnly SameSite=Strict"
          },
          "401": {
            "description": "Intento o token inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "OIDC deshabilitado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Admisión OIDC limitada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Proveedor, PostgreSQL o capacidad de intentos no disponible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/oidc/config": {
      "get": {
        "tags": [
          "session"
        ],
        "description": "Acción session:login, recurso sesión propia; público, no revela secretos.",
        "operationId": "getOidcConfig",
        "responses": {
          "200": {
            "description": "Disponibilidad del login corporativo",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginConfig"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/oidc/start": {
      "post": {
        "tags": [
          "session"
        ],
        "description": "Acción session:login, recurso sesión propia. Origin obligatorio. PKCE S256, nonce y state con vida de cinco minutos. Redirección fija.",
        "operationId": "startOidcLogin",
        "responses": {
          "200": {
            "description": "URL del proveedor y cookie temporal HttpOnly",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginStart"
                }
              }
            }
          },
          "400": {
            "description": "Parámetros no permitidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Origin inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "OIDC deshabilitado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Admisión OIDC limitada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Proveedor, PostgreSQL o capacidad de intentos no disponible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/queries": {
      "post": {
        "tags": [
          "queries"
        ],
        "summary": "Consulta agregada tipada sobre un dataset permitido; sin SQL del cliente.",
        "operationId": "runQuery",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QueryRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Resultado tipado y exacto; fases en la cabecera `Server-Timing` (plan, queue, execute, serialize; ms)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueryResult"
                }
              }
            }
          },
          "400": {
            "description": "JSON inválido o campos desconocidos",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Sin sesión válida (`session_required`)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Origin ausente o distinto al configurado (`origin_forbidden`)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Consulta fuera del catálogo o de los límites (`invalid_query`), resultado mayor que el presupuesto de bytes (`result_too_large`) o memoria de consulta agotada (`query_memory_limit`)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Cola de consultas llena; reintentar",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "500": {
            "description": "Fallo interno al ejecutar",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Motor analítico no disponible",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "504": {
            "description": "Superó el tiempo máximo y se canceló",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "sessionCookie": []
          }
        ]
      }
    },
    "/api/v1/session": {
      "get": {
        "tags": [
          "session"
        ],
        "operationId": "getSession",
        "responses": {
          "200": {
            "description": "Sesión verificada por el servidor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "401": {
            "description": "Sin sesión válida",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "PostgreSQL no disponible",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "sessionCookie": []
          }
        ]
      }
    },
    "/health/live": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Liveness: el proceso responde. No consulta dependencias.",
        "operationId": "getLiveness",
        "responses": {
          "200": {
            "description": "Proceso activo",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Readiness: PostgreSQL accesible, migraciones aplicadas y, si está habilitado, el lago analítico listo.",
        "operationId": "getReadiness",
        "responses": {
          "200": {
            "description": "Listo para servir",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "No listo; `checks` indica qué dependencia falla",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ColumnType": {
        "type": "string",
        "description": "Logical type of a result column. Every non-null value travels as a JSON\nstring, so `integer` (64- or 128-bit) and `decimal` stay exact in clients.",
        "enum": [
          "string",
          "integer",
          "decimal",
          "timestamptz"
        ]
      },
      "DataScope": {
        "type": "string",
        "enum": [
          "synthetic"
        ]
      },
      "DevLogin": {
        "type": "object",
        "required": [
          "user_id"
        ],
        "properties": {
          "user_id": {
            "type": "string",
            "description": "Selects a configured synthetic identity; this is not password authentication."
          }
        },
        "additionalProperties": false
      },
      "DiagnosticSeverity": {
        "type": "string",
        "enum": [
          "error",
          "warning"
        ]
      },
      "Filter": {
        "type": "object",
        "required": [
          "field",
          "op",
          "values"
        ],
        "properties": {
          "field": {
            "type": "string",
            "description": "A dimension of the dataset."
          },
          "op": {
            "$ref": "#/components/schemas/FilterOp"
          },
          "values": {
            "type": "array",
            "items": {
              "type": [
                "string",
                "null"
              ]
            },
            "description": "1 to 100 values; `null` matches missing values."
          }
        },
        "additionalProperties": false
      },
      "FilterOp": {
        "type": "string",
        "enum": [
          "in"
        ]
      },
      "Health": {
        "type": "object",
        "required": [
          "status",
          "checks"
        ],
        "properties": {
          "checks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HealthCheck"
            }
          },
          "status": {
            "$ref": "#/components/schemas/HealthStatus"
          }
        },
        "additionalProperties": false
      },
      "HealthCheck": {
        "type": "object",
        "required": [
          "name",
          "status"
        ],
        "properties": {
          "name": {
            "type": "string",
            "examples": [
              "postgres",
              "migrations"
            ]
          },
          "status": {
            "$ref": "#/components/schemas/HealthStatus"
          }
        },
        "additionalProperties": false
      },
      "HealthStatus": {
        "type": "string",
        "enum": [
          "ok",
          "degraded",
          "unavailable"
        ]
      },
      "LoginConfig": {
        "type": "object",
        "required": [
          "enabled"
        ],
        "properties": {
          "enabled": {
            "type": "boolean"
          }
        }
      },
      "LoginStart": {
        "type": "object",
        "required": [
          "authorization_url"
        ],
        "properties": {
          "authorization_url": {
            "type": "string"
          }
        }
      },
      "ModelAiContext": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "$ref": "#/components/schemas/ModelAiContextObject"
          }
        ],
        "description": "Context is descriptive, never executable or a semantic name alias."
      },
      "ModelAiContextObject": {
        "type": "object",
        "properties": {
          "examples": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          },
          "instructions": {
            "type": [
              "string",
              "null"
            ]
          },
          "synonyms": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": {
          "description": "Unknown keys are preserved without interpretation."
        }
      },
      "ModelAnnotation": {
        "type": "object",
        "required": [
          "name",
          "path"
        ],
        "properties": {
          "ai_context": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ModelAiContext"
              },
              {
                "type": "null"
              }
            ]
          },
          "declared_is_time": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "Explicit declaration; null means the datatype supplies the default."
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "is_time": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "Effective time role for fields/dimensions; null for a metric."
          },
          "label": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": "string",
            "description": "Ossie declaration name, useful when a dimension has several origins."
          },
          "path": {
            "type": "string",
            "description": "JSON pointer in this Ossie file, identifying the declaration."
          }
        }
      },
      "ModelDataset": {
        "type": "object",
        "required": [
          "name",
          "fields"
        ],
        "properties": {
          "ai_context": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ModelAiContext"
              },
              {
                "type": "null"
              }
            ]
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "fields": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ModelField"
            },
            "description": "All declared fields, including computed fields that CSMIR inlines."
          },
          "name": {
            "type": "string"
          }
        }
      },
      "ModelDiagnostic": {
        "type": "object",
        "required": [
          "code",
          "severity",
          "path",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "column": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "minimum": 0
          },
          "line": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "minimum": 0
          },
          "message": {
            "type": "string"
          },
          "path": {
            "type": "string",
            "description": "JSON pointer; empty string denotes the document root."
          },
          "severity": {
            "$ref": "#/components/schemas/DiagnosticSeverity"
          }
        }
      },
      "ModelField": {
        "type": "object",
        "required": [
          "name",
          "is_dimension",
          "annotation"
        ],
        "properties": {
          "annotation": {
            "$ref": "#/components/schemas/ModelAnnotation"
          },
          "is_dimension": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "ModelFile": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "file",
              "name",
              "fingerprint",
              "datasets",
              "metrics",
              "dimensions",
              "diagnostics",
              "status"
            ],
            "properties": {
              "ai_context": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/ModelAiContext"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "datasets": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ModelDataset"
                }
              },
              "description": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "diagnostics": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ModelDiagnostic"
                }
              },
              "dimensions": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ModelMember"
                }
              },
              "file": {
                "type": "string"
              },
              "fingerprint": {
                "type": "string"
              },
              "metrics": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ModelMember"
                }
              },
              "name": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "valid"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "file",
              "name",
              "diagnostics",
              "status"
            ],
            "properties": {
              "diagnostics": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ModelDiagnostic"
                }
              },
              "file": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "invalid"
                ]
              }
            }
          }
        ],
        "description": "An invalid file never exposes metadata from a previous successful load."
      },
      "ModelMember": {
        "type": "object",
        "required": [
          "id",
          "name",
          "data_type",
          "annotations"
        ],
        "properties": {
          "annotations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ModelAnnotation"
            },
            "description": "Metadata per Ossie origin; conformed dimensions keep every binding."
          },
          "data_type": {
            "type": "string",
            "description": "Exact logical type, e.g. INT64, DECIMAL(18,2), TIMESTAMPTZ (instant)."
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "nullable": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "Direct dimension binding nullability. Null means not inferred for\ncomputed dimensions or metrics, whose result has not been executed."
          }
        }
      },
      "ModelsResponse": {
        "type": "object",
        "required": [
          "project_status",
          "models",
          "diagnostics"
        ],
        "properties": {
          "diagnostics": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ModelDiagnostic"
            }
          },
          "models": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ModelFile"
            }
          },
          "project_status": {
            "$ref": "#/components/schemas/ProjectStatus"
          }
        }
      },
      "Problem": {
        "type": "object",
        "required": [
          "type",
          "title",
          "status",
          "code",
          "request_id"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable identifier for clients, e.g. `invalid_query`.",
            "pattern": "^[a-z][a-z0-9_]+$"
          },
          "detail": {
            "type": [
              "string",
              "null"
            ],
            "description": "Human-readable explanation, safe to show; never internal errors."
          },
          "request_id": {
            "type": "string",
            "description": "Correlates with server logs (`x-request-id`).",
            "minLength": 1
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "maximum": 599,
            "minimum": 400
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "format": "uri",
            "description": "Problem type URI; `about:blank` means the HTTP status says it all."
          }
        }
      },
      "ProjectStatus": {
        "type": "string",
        "enum": [
          "not_configured",
          "ready",
          "unavailable"
        ]
      },
      "QueryRequest": {
        "type": "object",
        "description": "An aggregate query over an allowlisted dataset. No SQL is accepted.",
        "required": [
          "dataset",
          "measures"
        ],
        "properties": {
          "dataset": {
            "type": "string",
            "description": "Dataset name, e.g. `sales`."
          },
          "dimensions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Group-by fields (at most 2)."
          },
          "filters": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Filter"
            },
            "description": "Conditions on dimensions, combined with AND."
          },
          "limit": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "Maximum rows returned, 1 to 10000 (default 1000).",
            "maximum": 10000,
            "minimum": 1
          },
          "measures": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Aggregates to compute (1 to 8)."
          },
          "sort": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SortKey"
            },
            "description": "Ordering by selected fields; ties are broken by the dimensions."
          }
        },
        "additionalProperties": false,
        "example": {
          "dataset": "sales",
          "dimensions": [
            "region"
          ],
          "filters": [
            {
              "field": "region",
              "op": "in",
              "values": [
                "north",
                null
              ]
            }
          ],
          "limit": 100,
          "measures": [
            "row_count",
            "amount_sum"
          ],
          "sort": [
            {
              "direction": "desc",
              "field": "amount_sum"
            }
          ]
        }
      },
      "QueryResult": {
        "type": "object",
        "required": [
          "columns",
          "rows",
          "row_count",
          "truncated"
        ],
        "properties": {
          "columns": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ResultColumn"
            }
          },
          "row_count": {
            "type": "integer",
            "minimum": 0
          },
          "rows": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "description": "Rows in column order. Every non-null value is a string in its column's\ntype (`integer` and `decimal` are exact; `null` means missing)."
          },
          "truncated": {
            "type": "boolean",
            "description": "More rows matched than `limit` allowed."
          }
        }
      },
      "ResultColumn": {
        "type": "object",
        "description": "Describes one column of a [`super::QueryResult`].",
        "required": [
          "name",
          "type",
          "nullable"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "nullable": {
            "type": "boolean"
          },
          "precision": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "Present for `decimal`.",
            "minimum": 0
          },
          "scale": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "Present for `decimal`.",
            "minimum": 0
          },
          "type": {
            "$ref": "#/components/schemas/ColumnType"
          }
        }
      },
      "Session": {
        "type": "object",
        "required": [
          "user",
          "data_scope",
          "expires_at"
        ],
        "properties": {
          "data_scope": {
            "$ref": "#/components/schemas/DataScope",
            "description": "Server-derived restriction. This session grants no access to real sources."
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "user": {
            "$ref": "#/components/schemas/User"
          }
        },
        "additionalProperties": false
      },
      "SortDirection": {
        "type": "string",
        "enum": [
          "asc",
          "desc"
        ]
      },
      "SortKey": {
        "type": "object",
        "required": [
          "field"
        ],
        "properties": {
          "direction": {
            "$ref": "#/components/schemas/SortDirection"
          },
          "field": {
            "type": "string",
            "description": "A selected dimension or measure."
          }
        },
        "additionalProperties": false
      },
      "User": {
        "type": "object",
        "required": [
          "id",
          "display_name"
        ],
        "properties": {
          "display_name": {
            "type": "string"
          },
          "id": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "bi_session"
      }
    }
  },
  "security": []
}
